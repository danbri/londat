PREFIX s: <https://schema.org/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX void: <http://rdfs.org/ns/void#>
PREFIX cwk: <https://danbri.github.io/londat/kgx/vocab#>
# Restrooms and facility units by mall and floor
SELECT ?mall ?floor ?name ?class WHERE { GRAPH ?g { ?unit a cwk:MallUnit ; cwk:unitClass ?class ; s:name ?name ; cwk:mall ?mall ; cwk:floorName ?floor . FILTER(?class IN ("restroom", "facility")) } } ORDER BY ?mall ?floor ?name

PREFIX s: <https://schema.org/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX void: <http://rdfs.org/ns/void#>
PREFIX cwk: <https://danbri.github.io/londat/kgx/vocab#>
# Places open on a day at a minute of the day (edit Tuesday and 900 = 15:00)
SELECT ?place ?name ?opens ?closes WHERE { GRAPH ?g { ?place s:openingHoursSpecification ?h ; s:name ?name . ?h s:dayOfWeek s:Tuesday ; cwk:opensMinute ?o ; cwk:closesMinute ?c ; s:opens ?opens ; s:closes ?closes . FILTER(?o <= 900 && ?c > 900) } } ORDER BY ?name

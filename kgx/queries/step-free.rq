PREFIX s: <https://schema.org/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX void: <http://rdfs.org/ns/void#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX cwk: <https://kgx.foaf.tv/vocab#>
PREFIX id: <https://kgx.foaf.tv/id/>
# The store's graphs are parts of graph versions, cut by subject: write one GRAPH block per subject.
# Lifts, ramps, escalators, stairs and entrances by mall and floor
SELECT ?mall ?floor ?type (COUNT(?f) AS ?count) WHERE { GRAPH ?g { ?f a cwk:Facility ; cwk:unitType ?type ; cwk:floorName ?floor ; cwk:floorLevel ?lv . OPTIONAL { ?f cwk:mall ?m0 } BIND(COALESCE(?m0, "(no mall)") AS ?mall) FILTER(?type IN ("lift", "ramp", "escalator", "stairs", "entrance")) } } GROUP BY ?mall ?floor ?lv ?type ORDER BY ?mall ?lv ?type

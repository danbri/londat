PREFIX s: <https://schema.org/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX void: <http://rdfs.org/ns/void#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX cwk: <https://kgx.foaf.tv/vocab#>
PREFIX id: <https://kgx.foaf.tv/id/>
# The store's graphs are parts of graph versions, cut by subject: write one GRAPH block per subject.
# Registry buildings by height (OSM height tag, metres)
SELECT ?building ?name ?height ?levels WHERE { GRAPH ?g { ?building cwk:heightMetres ?height . OPTIONAL { ?building s:name ?name } OPTIONAL { ?building cwk:levels ?levels } } } ORDER BY DESC(?height)

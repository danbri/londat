PREFIX s: <https://schema.org/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX void: <http://rdfs.org/ns/void#>
PREFIX cwk: <https://danbri.github.io/londat/kgx/vocab#>
# Mall units by mall and floor (Living Map)
SELECT ?mall ?floor (COUNT(?u) AS ?units) WHERE { GRAPH ?g { ?u a cwk:MallUnit ; cwk:mall ?mall ; cwk:floorName ?floor ; cwk:floorLevel ?lv } } GROUP BY ?mall ?floor ?lv ORDER BY ?mall ?lv

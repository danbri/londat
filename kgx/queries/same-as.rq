PREFIX s: <https://schema.org/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX void: <http://rdfs.org/ns/void#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX cwk: <https://danbri.github.io/londat/kgx/vocab#>
# The store's graphs are parts of graph versions, cut by subject: write one GRAPH block per subject.
# owl:sameAs links made by the key rules, with the rule graph
SELECT ?a ?b ?g WHERE { GRAPH ?g { ?a owl:sameAs ?b } }

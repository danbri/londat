PREFIX s: <https://schema.org/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX void: <http://rdfs.org/ns/void#>
PREFIX cwk: <https://danbri.github.io/londat/kgx/vocab#>
# Cited facts with their source
SELECT ?subject ?property ?value ?unit ?source WHERE { GRAPH ?g { ?f a cwk:CitedFact ; cwk:about ?x ; s:propertyID ?property ; s:value ?value ; s:citation ?source . OPTIONAL { ?f s:unitText ?unit } ?x rdfs:label ?subject } } ORDER BY ?subject ?property

PREFIX s: <https://schema.org/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX void: <http://rdfs.org/ns/void#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX cwk: <https://kgx.foaf.tv/vocab#>
PREFIX id: <https://kgx.foaf.tv/id/>
# The store's graphs are parts of graph versions, cut by subject: write one GRAPH block per subject.
# Everything the graph says about one thing (edit the IRI); a constant subject lets the zone maps skip most blocks
SELECT ?g ?p ?o WHERE { GRAPH ?g { <https://canarywharf.com/restaurant/manhattan-grill/#entity> ?p ?o } }

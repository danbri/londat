PREFIX s: <https://schema.org/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX void: <http://rdfs.org/ns/void#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX cwk: <https://danbri.github.io/londat/kgx/vocab#>
PREFIX id: <https://kgx.foaf.tv/id/>
# The store's graphs are parts of graph versions, cut by subject: write one GRAPH block per subject.
# Each graph name, its current version (named by its RDFC-1.0 hash), size and licence
SELECT ?name ?version ?triples ?title ?licence WHERE { GRAPH ?m { ?graph cwk:current ?version ; rdfs:label ?name . ?version void:triples ?triples ; dct:title ?title ; dct:license ?licence } } ORDER BY DESC(?triples)

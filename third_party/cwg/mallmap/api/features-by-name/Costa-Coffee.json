{"object":"list","url":"/v1/maps/canary_wharf/features","data":[{"id":"8e23a66889b2da0f71bc7815871f1192","uid":848821637713,"object":"map-feature","type":"indoor","is_temporarily_closed":false,"label":{"icon":"cafe","is_visible":true,"name":[{"lang":"en-GB","text":"Costa Coffee"}],"reference":[{"lang":"en-GB","text":null}]},"categories":{"category":{"id":"food_and_drink","name":[{"lang":"en-GB","text":"food_and_drink"}]},"subcategory":{"id":"cafe","name":[{"lang":"en-GB","text":"cafe"}]}},"rank":{"value":3},"street_address":"Cabot Place, Canary Wharf, London, E14 4QS","location":{"center":{"latitude":51.505320734,"longitude":-0.022173219},"floor":{"id":3,"floor":"-1.0","name":[{"lang":"en-GB","text":"Level -1"}],"default":false,"short_name":"-1"}},"information":{"description":[{"lang":"en-GB","text":"Costa baristas have been serving perfect coffee since 1971, lovingly handcrafting every cup from our unique Mocha Italia blend. The beans are first slow roasted, then they are ground and extracted for a full 20 seconds each and every time, before forming the perfect espresso. Only in this way do our baristas make the smooth, aromatic coffee that our customers know and love.\n\nLocation: Cabot Place"}],"long_name":[{"lang":"en-GB","text":"Costa Coffee"}],"phone_number":"020 7512 9251","summary":[{"lang":"en-GB","text":"Food & Drink; Cafe's"}],"links":[{"type":"general","url":"http://www.costa.co.uk"}],"operating_hours":{"monday":[{"opening_time":"09:00","closing_time":"20:00"}],"tuesday":[{"opening_time":"09:00","closing_time":"20:00"}],"wednesday":[{"opening_time":"09:00","closing_time":"20:00"}],"thursday":[{"opening_time":"09:00","closing_time":"20:00"}],"friday":[{"opening_time":"09:00","closing_time":"20:00"}],"saturday":[{"opening_time":"10:00","closing_time":"19:00"}],"sunday":[{"opening_time":"12:00","closing_time":"18:00"}]}},"media":{"360":null,"popup":null},"transport_api":null,"area_highlight":null}]}
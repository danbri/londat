{"object":"list","url":"/v1/maps/canary_wharf/features","data":[{"id":"9bd258a53fe1aaca767712f34268c107","uid":383511673763,"object":"map-feature","type":"indoor","is_temporarily_closed":false,"label":{"icon":null,"is_visible":true,"name":[{"lang":"en-GB","text":"Yolk"}],"reference":[{"lang":"en-GB","text":null}]},"categories":{"category":{"id":"food_and_drink","name":[{"lang":"en-GB","text":"food_and_drink"}]},"subcategory":{"id":"food_to_go","name":[{"lang":"en-GB","text":"food_to_go"}]}},"rank":{"value":3},"street_address":"0 Street Level, Cabot Place","location":{"center":{"latitude":51.505223409,"longitude":-0.021406003},"floor":{"id":4,"floor":"0.0","name":[{"lang":"en-GB","text":"Level 0"}],"default":true,"short_name":"0"}},"information":{"description":[{"lang":"en-GB","text":"Now open in Cabot Place…\n\nYolk was born out of frustration – in London, a wonderful culinary city, why should grab-&-go be so dull? Bored of bland staples and flavourless chains, they craved a takeaway option that didn’t compromise on excitement.\n\nAnd so, after years of pop-ups and thousands of test kitchen hours, they’ve opened their third Yolk at Canary Wharf.\n\nLocation: Cabot Place"}],"long_name":[{"lang":"en-GB","text":"Yolk"}],"phone_number":null,"summary":[{"lang":"en-GB","text":"Food & Drink; Food to go"}],"links":[{"type":"general","url":"http://www.yolklondon.com"}],"operating_hours":{"monday":[{"opening_time":"07:30","closing_time":"16:30"}],"tuesday":[{"opening_time":"07:30","closing_time":"16:30"}],"wednesday":[{"opening_time":"07:30","closing_time":"16:30"}],"thursday":[{"opening_time":"07:30","closing_time":"16:30"}],"friday":[{"opening_time":"07:30","closing_time":"16:30"}],"saturday":[{"opening_time":"11:00","closing_time":"17:00"}],"sunday":null}},"media":{"360":null,"popup":{"url":"https://mms-assets.prod.livingmap.com/canary_wharf/9bd258a53fe1aaca767712f34268c107-1714386831486.jpeg"}},"transport_api":null,"area_highlight":null}]}
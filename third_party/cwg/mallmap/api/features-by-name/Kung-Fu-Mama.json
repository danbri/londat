{"object":"list","url":"/v1/maps/canary_wharf/features","data":[{"id":"58661e2c822d25f84a4f2d10f9b541e6","uid":30630150009,"object":"map-feature","type":"indoor","is_temporarily_closed":false,"label":{"icon":null,"is_visible":true,"name":[{"lang":"en-GB","text":"Kung Fu Mama"}],"reference":[{"lang":"en-GB","text":null}]},"categories":{"category":{"id":"food_and_drink","name":[{"lang":"en-GB","text":"food_and_drink"}]},"subcategory":{"id":"cafe","name":[{"lang":"en-GB","text":"cafe"}]}},"rank":{"value":3},"street_address":"-2 level, Jubilee Place","location":{"center":{"latitude":51.503016615,"longitude":-0.017885892},"floor":{"id":2,"floor":"-2.0","name":[{"lang":"en-GB","text":"Level -2"}],"default":false,"short_name":"-2"}},"information":{"description":[{"lang":"en-GB","text":"Kung Fu Mama brings the flavours of Taiwan’s night markets to London with a bright and healthy twist. At the heart of Kung Fu Mama is their signature sun-dried noodles, made by hand in Taiwan. Dishes include noodle bowls such as Chicken with Ginger & Sesame and 12-Hour Beef Noodles, plus their creative baos. The founders Noam Bar and Chris Hsu believe in bringing a contemporary take on Taiwanese flavours, with food that is high-quality and full of flavour."}],"long_name":[{"lang":"en-GB","text":"Kung Fu Mama"}],"phone_number":null,"summary":[{"lang":"en-GB","text":"Food & Drink; Food to go"}],"links":[{"type":"general","url":"https://kungfumama.co.uk"}],"operating_hours":{"monday":[{"opening_time":"11:00","closing_time":"21:00"}],"tuesday":[{"opening_time":"11:00","closing_time":"21:00"}],"wednesday":[{"opening_time":"11:00","closing_time":"21:00"}],"thursday":[{"opening_time":"11:00","closing_time":"21:00"}],"friday":[{"opening_time":"11:00","closing_time":"21:00"}],"saturday":[{"opening_time":"12:00","closing_time":"19:00"}],"sunday":[{"opening_time":"12:00","closing_time":"18:00"}]}},"media":{"360":null,"popup":null},"transport_api":null,"area_highlight":null}]}
":"Subway"}],"reference":[{"lang":"en-GB","text":null}]},"categories":{"category":{"id":"food_and_drink","name":[{"lang":"en-GB","text":"food_and_drink"}]},"subcategory":{"id":"food_to_go","name":[{"lang":"en-GB","text":"food_to_go"}]}},"rank":{"value":3},"street_address":"0 Street level, 11 Westferry Circus","location":{"center":{"latitude":51.505944093,"longitude":-0.025469124},"floor":{"id":4,"floor":"0.0","name":[{"lang":"en-GB","text":"Level 0"}],"default":true,"short_name":"0"}},"information":{"description":[{"lang":"en-GB","text":"At your local Subway®, 11 Westferry Circus, when we say you can Make It What You Want ®, we really mean it.\n\nCreate your own sub, salad or wrap and fill it with everything that you love.\n\nFancy something meaty but want to hold off on the olives? Sure. Want to turn up the heat with extra hot sauce? No problem. Want extra cheese on top of extra cheese? If that’s what you like!\n\nChoose from our delicious range of meats or plant-based alternatives, topped with tasty cheeses, freshly cut veggies, and finished with a choice of our signature sauces.\n\nAll Subway® stores are independently owned with talented Sandwich Artists™ ready to take your order in-store, for collection via our Subcard® app, or delivered straight to your home via our friends over at Just Eat, Uber Eats or Deliveroo.\n\nSo go meaty, go plant-based, go spicy, go saucy, or just go ALL OUT."}],"long_name":[{"lang":"en-GB","text":"Subway"}],"phone_number":"08004049557","summary":[{"lang":"en-GB","text":"Food & Drink; Restaurants"}],"links":[{"type":"general","url":"https://www.subway.com"}],"operating_hours":{"monday":[{"opening_time":"08:00","closing_time":"23:30"}],"tuesday":[{"opening_time":"08:00","closing_time":"23:30"}],"wednesday":[{"opening_time":"08:00","closing_time":"23:30"}],"thursday":[{"opening_time":"08:00","closing_time":"23:30"}],"friday":[{"opening_time":"08:00","closing_time":"23:30"}],"saturday":[{"opening_time":"08:00","closing_time":"23:30"}],"s
rily_closed":false,"label":{"icon":null,"is_visible":true,"name":[{"lang":"en-GB","text":"Smilepod"}],"reference":[{"lang":"en-GB","text":null}]},"categories":{"category":{"id":"retail","name":[{"lang":"en-GB","text":"retail"}]},"subcategory":{"id":"beauty","name":[{"lang":"en-GB","text":"beauty"}]}},"rank":{"value":3},"street_address":"-1M level, Jubilee Place","location":{"center":{"latitude":51.503207123,"longitude":-0.018655849},"floor":{"id":7,"floor":"-0.5","name":[{"lang":"en-GB","text":"Level -1M"}],"default":false,"short_name":"-1M"}},"information":{"description":[{"lang":"en-GB","text":"Smilepod offers a new approach to dentistry, which takes away the irritations of traditional practices to make professional dental care truly accessible for the first time.\n\nBeing in the heart of the Jubilee place mall we welcome in both tourists and the hard working Canary Wharf community. This studio is also open on Saturdays by popular demand, allowing clients the flexibility they need for quality preventative and cosmetic dental care.\n\nJubilee Place is great for:\n\n- Businessmen and women who don't have the time to visit their local dentist\n- Emergency treatments: we provide on-the-day appointments as much as possible\n- Cosmetic dentistry: whitening and straightening\n- Lunchtime, evening and Saturday appointments\n- A modern, professional dental environment\n\nLocation: Jubilee Place"}],"long_name":[{"lang":"en-GB","text":"Smilepod"}],"phone_number":"020 7836 6866","summary":[{"lang":"en-GB","text":"Health & Beauty; Health Services"}],"links":[{"type":"general","url":"http://www.smilepod.co.uk"}],"operating_hours":{"monday":[{"opening_time":"08:00","closing_time":"19:00"}],"tuesday":[{"opening_time":"08:00","closing_time":"19:00"}],"wednesday":[{"opening_time":"08:00","closing_time":"19:00"}],"thursday":[{"opening_time":"08:00","closing_time":"19:00"}],"friday":[{"opening_time":"08:00","closing_time":"19:00"}],"saturday":[{"opening_time":"10:00","closing_time":"
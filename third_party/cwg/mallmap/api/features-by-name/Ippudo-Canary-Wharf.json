{"object":"list","url":"/v1/maps/canary_wharf/features","data":[{"id":"c9ec2bdef1a2092b2d2ae3c300ba68ab","uid":182156866469,"object":"map-feature","type":"indoor","is_temporarily_closed":false,"label":{"icon":null,"is_visible":true,"name":[{"lang":"en-GB","text":"Ippudo Canary Wharf"}],"reference":[{"lang":"en-GB","text":null}]},"categories":{"category":{"id":"food_and_drink","name":[{"lang":"en-GB","text":"food_and_drink"}]},"subcategory":{"id":"restaurant","name":[{"lang":"en-GB","text":"restaurant"}]}},"rank":{"value":3},"street_address":"-1 Quayside, Crossrail Place","location":{"center":{"latitude":51.506168049,"longitude":-0.018128861},"floor":{"id":3,"floor":"-1.0","name":[{"lang":"en-GB","text":"Level -1"}],"default":false,"short_name":"-1"}},"information":{"description":[{"lang":"en-GB","text":"IPPUDO brings to Canary Wharf the best of ramen, the soul food of Japan!\nWorld renowned for its reinvented Hakata-style tonkotsu (pork-based) ramen, IPPUDO believes in fusing high quality local ingredients to Japanese elements. Here in London, we offer a variety of tasty broths (tonkotsu, chicken or vegetarian) and our original house-made noodles, for perfect bowls of piping-hot ramen.\n\nIPPUDO's aim is to continue spreading smiles and \"Arigato\" through bowls of delicious ramen, in a vibrant and authentic ambience.\n\nLocation: Crossrail Place"}],"long_name":[{"lang":"en-GB","text":"Ippudo Canary Wharf"}],"phone_number":"020 3326 9485","summary":[{"lang":"en-GB","text":"Food & Drink; Restaurants & Bars"}],"links":[{"type":"general","url":"http://www.ippudo.co.uk"}],"operating_hours":{"monday":[{"opening_time":"11:30","closing_time":"22:00"}],"tuesday":[{"opening_time":"11:30","closing_time":"22:00"}],"wednesday":[{"opening_time":"11:30","closing_time":"22:00"}],"thursday":[{"opening_time":"11:30","closing_time":"22:30"}],"friday":[{"opening_time":"11:30","closing_time":"22:30"}],"saturday":[{"opening_time":"11:30","closing_time":"22:00"}],"sunday":[{"opening_time
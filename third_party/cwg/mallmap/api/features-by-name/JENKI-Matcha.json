{"object":"list","url":"/v1/maps/canary_wharf/features","data":[{"id":"4aca3043349abd2fcea8a27409dd57cd","uid":504124703101,"object":"map-feature","type":"indoor","is_temporarily_closed":false,"label":{"icon":null,"is_visible":true,"name":[{"lang":"en-GB","text":"JENKI Matcha"}],"reference":[{"lang":"en-GB","text":null}]},"categories":{"category":{"id":"food_and_drink","name":[{"lang":"en-GB","text":"food_and_drink"}]},"subcategory":{"id":"food_to_go","name":[{"lang":"en-GB","text":"food_to_go"}]}},"rank":{"value":3},"street_address":"-2 level, Jubilee Place","location":{"center":{"latitude":51.503236601,"longitude":-0.019107899},"floor":{"id":2,"floor":"-2.0","name":[{"lang":"en-GB","text":"Level -2"}],"default":false,"short_name":"-2"}},"information":{"description":[{"lang":"en-GB","text":"Hi! We're Claudia and Otto Boyer \n\nWe were both wired and jittery, running on too much coffee and not enough calm. Then we discovered matcha.\n\nBut finding delicious matcha in the UK? Impossible. So we went to Japan to source the best, meeting the makers, tasting hundreds, and learning what makes matcha truly great.\n\nWe brought that discovery home, creating JENKI in 2020 to share the ultimate matcha experience with London and beyond.\n\nOur name comes from genki 元気, the Japanese word for life force, energy, and vitality. That’s what we’re here to spread: clean green energy that lifts you up, not crashes you down."}],"long_name":[{"lang":"en-GB","text":"JENKI Matcha"}],"phone_number":null,"summary":[{"lang":"en-GB","text":"Food & Drink; Restaurants & Bars"}],"links":[{"type":"general","url":"https://www.jenki.co.uk"}],"operating_hours":{"monday":[{"opening_time":"07:00","closing_time":"20:00"}],"tuesday":[{"opening_time":"07:00","closing_time":"20:00"}],"wednesday":[{"opening_time":"07:00","closing_time":"20:00"}],"thursday":[{"opening_time":"07:00","closing_time":"20:00"}],"friday":[{"opening_time":"07:00","closing_time":"20:00"}],"saturday":[{"opening_time":"08:00","closing_time":"20:00"}],"sunday":[{"opening_time":"08:00","closing_time":"19:00"}]}},"media":{"360":null,"popup":null},"transport_api":null,"area_highlight":null}]}
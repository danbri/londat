{"object":"list","url":"/v1/maps/canary_wharf/features","data":[{"id":"92182794e3ac5cc7ee8e47a7c45d864c","uid":273372005941,"object":"map-feature","type":"indoor","is_temporarily_closed":false,"label":{"icon":null,"is_visible":true,"name":[{"lang":"en-GB","text":"Fairgame"}],"reference":[{"lang":"en-GB","text":null}]},"categories":{"category":{"id":"entertainment","name":[{"lang":"en-GB","text":"entertainment"}]},"subcategory":{"id":"amusement_arcade","name":[{"lang":"en-GB","text":"amusement_arcade"}]}},"rank":{"value":2},"street_address":"-1 level, 25-35 Fisherman’s Walk","location":{"center":{"latitude":51.506138675,"longitude":-0.021679917},"floor":{"id":4,"floor":"0.0","name":[{"lang":"en-GB","text":"Level 0"}],"default":true,"short_name":"0"}},"information":{"description":[{"lang":"en-GB","text":"An entertainment concept, Fairgame brings all the sights, sounds and nonstop fun of the fairground to Canary Wharf. Their cutting-edge tech gives iconic games a new twist – from Roll-A-Ball Derby to Skeeball. Shoot the Clown to Whac-A-Mole – plus a few old favourites in between.\n\nGet ready to face-off in a fun-fuelled experience like no other. You’ll find London’s hottest street food vendors on site – the legendary Burger & Beyond, Rudy’s Neapolitan Pizza, and masters of Mexican, Dos Mas Tacos."}],"long_name":[{"lang":"en-GB","text":"Fairgame"}],"phone_number":null,"summary":[{"lang":"en-GB","text":"Competitive Socialising"}],"links":[{"type":"general","url":"http://www.wearefairgame.com"}],"operating_hours":{"monday":null,"tuesday":[{"opening_time":"11:30","closing_time":"00:00"}],"wednesday":[{"opening_time":"11:30","closing_time":"00:00"}],"thursday":[{"opening_time":"11:30","closing_time":"01:00"}],"friday":[{"opening_time":"11:30","closing_time":"01:00"}],"saturday":[{"opening_time":"11:30","closing_time":"01:00"}],"sunday":[{"opening_time":"11:30","closing_time":"23:00"}]}},"media":{"360":null,"popup":{"url":"https://mms-assets.prod.livingmap.com/canary_wharf/
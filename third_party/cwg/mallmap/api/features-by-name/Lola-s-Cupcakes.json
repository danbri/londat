{"object":"list","url":"/v1/maps/canary_wharf/features","data":[{"id":"b36d6cb8da9d38596dddca89b8a0b702","uid":616418459372,"object":"map-feature","type":"indoor","is_temporarily_closed":false,"label":{"icon":null,"is_visible":true,"name":[{"lang":"en-GB","text":"Lola's Cupcakes"}],"reference":[{"lang":"en-GB","text":null}]},"categories":{"category":{"id":"food_and_drink","name":[{"lang":"en-GB","text":"food_and_drink"}]},"subcategory":{"id":"food_to_go","name":[{"lang":"en-GB","text":"food_to_go"}]}},"rank":{"value":3},"street_address":"Canada Place, Canary Wharf, London, E14 5AH","location":{"center":{"latitude":51.504790495,"longitude":-0.016846397},"floor":{"id":3,"floor":"-1.0","name":[{"lang":"en-GB","text":"Level -1"}],"default":false,"short_name":"-1"}},"information":{"description":[{"lang":"en-GB","text":"Welcome to Lola's Cupcakes, where we have brought our passion for flavour, quality and great customer service to our store in Canary Wharf!\n\nIt's our promise that only freshly baked, handcrafted treats will be found at our counter. We don't believe in shortcuts and we spend months perfecting our recipes, which we bake from scratch, every day.\n\nCome visit us to try our large selection of scrumptious cupcakes including free from options, pick up one of our new mini cheesecakes or click and collect an extra special celebration cake.\n\nLocation: Canada Place"}],"long_name":[{"lang":"en-GB","text":"Lola's Cupcakes"}],"phone_number":"020 7516 0534","summary":[{"lang":"en-GB","text":"Food & Drink; Food to go"}],"links":[{"type":"general","url":"http://www.lolascupcakes.co.uk/"}],"operating_hours":{"monday":[{"opening_time":"07:00","closing_time":"20:00"}],"tuesday":[{"opening_time":"07:00","closing_time":"20:00"}],"wednesday":[{"opening_time":"07:00","closing_time":"20:00"}],"thursday":[{"opening_time":"07:00","closing_time":"20:00"}],"friday":[{"opening_time":"07:00","closing_time":"21:00"}],"saturday":[{"opening_time":"10:00","closing_time":"20:00"}],"sund
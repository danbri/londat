{"object":"list","url":"/v1/maps/canary_wharf/features","data":[{"id":"c7f1cd87138f28db111f55a9bf3aaa4a","uid":216651362223,"object":"map-feature","type":"indoor","is_temporarily_closed":false,"label":{"icon":null,"is_visible":true,"name":[{"lang":"en-GB","text":"Franco Manca"}],"reference":[{"lang":"en-GB","text":null}]},"categories":{"category":{"id":"food_and_drink","name":[{"lang":"en-GB","text":"food_and_drink"}]},"subcategory":{"id":"restaurant","name":[{"lang":"en-GB","text":"restaurant"}]}},"rank":{"value":3},"street_address":"-1 Quayside, Crossrail Place","location":{"center":{"latitude":51.50607118,"longitude":-0.017234372},"floor":{"id":3,"floor":"-1.0","name":[{"lang":"en-GB","text":"Level -1"}],"default":false,"short_name":"-1"}},"information":{"description":[{"lang":"en-GB","text":"Franco Manca was founded in 2008 on Brixton market by Giuseppe Mascoli and since then his sourdough pizza has been taking London by storm. The emphasis is on good quality ingredients cooked in the traditional methods by chefs from Naples.\n\nWith its seriously good value sourdough pizzas, it's easy to see why Franco Manca has earned a cult following. Their minimum 20 hour slow-risen sourdough bases are topped with high-quality ingredients like homemade mozzarella, organic tomato and cured organic chorizo, resulting in genuine, Neapolitan-style pizzas. Watch out for daily changing specials.\n\nLocation: Crossrail Place"}],"long_name":[{"lang":"en-GB","text":"Franco Manca"}],"phone_number":"020 3026 8748","summary":[{"lang":"en-GB","text":"Food & Drink; Restaurants & Bars"}],"links":[{"type":"general","url":"http://www.francomanca.co.uk/"}],"operating_hours":{"monday":[{"opening_time":"11:30","closing_time":"23:00"}],"tuesday":[{"opening_time":"11:30","closing_time":"23:00"}],"wednesday":[{"opening_time":"11:30","closing_time":"23:00"}],"thursday":[{"opening_time":"11:30","closing_time":"23:00"}],"friday":[{"opening_time":"11:30","closing_time":"23:00"}],"saturday":[{"opening_time":"11:30","closing_time":"23:00"}],"sunday":[{"opening_time":"12:00","closing_time":"22:00"}]}},"media":{"360":null,"popup":null},"transport_api":null,"area_highlight":null}]}
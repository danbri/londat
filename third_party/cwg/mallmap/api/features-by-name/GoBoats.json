{"object":"list","url":"/v1/maps/canary_wharf/features","data":[{"id":"67ed938ed5870fbd2e421e7bb52b6ab7","uid":635947958094,"object":"map-feature","type":"indoor","is_temporarily_closed":false,"label":{"icon":null,"is_visible":true,"name":[{"lang":"en-GB","text":"GoBoats"}],"reference":[{"lang":"en-GB","text":null}]},"categories":{"category":{"id":"facility","name":[{"lang":"en-GB","text":"facility"}]},"subcategory":{"id":"dock","name":[{"lang":"en-GB","text":"dock"}]}},"rank":{"value":2},"street_address":"0 Street level, 22 Churchill Place","location":{"center":{"latitude":51.503344179,"longitude":-0.0144571},"floor":{"id":3,"floor":"-1.0","name":[{"lang":"en-GB","text":"Level -1"}],"default":false,"short_name":"-1"}},"information":{"description":[{"lang":"en-GB","text":"GoBoat is the fun, self-drive boating experience. You are the captain, you choose the route. Begin your voyage from Bellmouth Passage, relish the freedom to explore the beautiful docklands and look up at the spectacular architecture. Cruise past Big Easy, the stunning One Park Drive; and for 2 or 3-hour boat rides, why not moor up and treat yourself to a picnic. No boating experience is necessary as training will be given upon arrival and you’ll be given a route map to help you navigate your way. We can take up to 8 people per boat and pre-booking is recommended.\n\nLocation: Churchill Place"}],"long_name":[{"lang":"en-GB","text":"GoBoats"}],"phone_number":null,"summary":[{"lang":"en-GB","text":"Everything Else; Boat Hire"}],"links":[{"type":"general","url":"https://www.goboat.co.uk"}],"operating_hours":{"monday":[{"opening_time":"12:00","closing_time":"16:45"}],"tuesday":[{"opening_time":"12:00","closing_time":"16:45"}],"wednesday":[{"opening_time":"12:00","closing_time":"16:45"}],"thursday":[{"opening_time":"12:00","closing_time":"16:45"}],"friday":[{"opening_time":"12:00","closing_time":"16:45"}],"saturday":[{"opening_time":"12:00","closing_time":"16:45"}],"sunday":[{"opening_time":"12:00","clos
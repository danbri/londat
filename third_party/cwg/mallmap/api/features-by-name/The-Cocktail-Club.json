{"object":"list","url":"/v1/maps/canary_wharf/features","data":[{"id":"b49e5ce8ba7d48e890fb624aa3e5baf8","uid":529374896610,"object":"map-feature","type":"indoor","is_temporarily_closed":false,"label":{"icon":"bar","is_visible":true,"name":[{"lang":"en-GB","text":"The Cocktail Club"}],"reference":[{"lang":"en-GB","text":null}]},"categories":{"category":{"id":"food_and_drink","name":[{"lang":"en-GB","text":"food_and_drink"}]},"subcategory":{"id":"bar","name":[{"lang":"en-GB","text":"bar"}]}},"rank":{"value":3},"street_address":"Cabot Square, Canary Wharf, London, E14","location":{"center":{"latitude":51.506048666,"longitude":-0.022432096},"floor":{"id":4,"floor":"0.0","name":[{"lang":"en-GB","text":"Level 0"}],"default":true,"short_name":"0"}},"information":{"description":[{"lang":"en-GB","text":"Now open in Cabot Square…\n\nThe Cocktail Club, formerly known as London Cocktail Club, has chosen Canary Wharf as the destination for their 17th site, their 11th in the capital. \n\nThe bar has a capacity of 100 and a sizeable terrace. It also hosts the ‘World’s Hottest Happy Hour’ every day, offering 2-4-1 on every drink 4-7pm.\n\nParty packages are on offer, with guests able to book cocktail masterclasses alongside private room and venue hire, as well as weekly Bottomless Brunch.\n\nLocation: Cabot Square"}],"long_name":[{"lang":"en-GB","text":"The Cocktail Club"}],"phone_number":null,"summary":[{"lang":"en-GB","text":"Eating & Drinking"}],"links":[{"type":"general","url":"https://www.thecocktailclub.com"}],"operating_hours":{"monday":[{"opening_time":"16:00","closing_time":"02:00"}],"tuesday":[{"opening_time":"16:00","closing_time":"02:00"}],"wednesday":[{"opening_time":"16:00","closing_time":"02:00"}],"thursday":[{"opening_time":"16:00","closing_time":"02:00"}],"friday":[{"opening_time":"16:00","closing_time":"02:00"}],"saturday":[{"opening_time":"12:00","closing_time":"02:00"}],"sunday":[{"opening_time":"12:00","closing_time":"00:00"}]}},"media":{"360":null,"popup":{"url":"https://mms-assets.prod.livingmap.com/canary_wharf/b49e5ce8ba7d48e890fb624aa3e5baf8-1714382945980.jpeg"}},"transport_api":null,"area_highlight":null}]}
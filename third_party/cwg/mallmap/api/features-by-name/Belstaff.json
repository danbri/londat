{"object":"list","url":"/v1/maps/canary_wharf/features","data":[{"id":"23005ade6a701997934ec180752d87dd","uid":471407531637,"object":"map-feature","type":"indoor","is_temporarily_closed":false,"label":{"icon":null,"is_visible":true,"name":[{"lang":"en-GB","text":"Belstaff"}],"reference":[{"lang":"en-GB","text":null}]},"categories":{"category":{"id":"retail","name":[{"lang":"en-GB","text":"retail"}]},"subcategory":{"id":"clothing","name":[{"lang":"en-GB","text":"clothing"}]}},"rank":{"value":3},"street_address":"-1 level, Jubilee Place","location":{"center":{"latitude":51.503138425,"longitude":-0.019120927},"floor":{"id":3,"floor":"-1.0","name":[{"lang":"en-GB","text":"Level -1"}],"default":false,"short_name":"-1"}},"information":{"description":[{"lang":"en-GB","text":"Founded in 1924, we are a British modern heritage brand with a rich history of moving people forwards. Built on 100 years of outerwear excellence and motoring innovation, we have equipped successive generations with lasting apparel for life’s pursuits.\n\n\n\nOver the decades, we have designed protective suits for racing drivers to give them the confidence to go faster.\n\n\n\nWe’ve developed windproof smocks for Marines to help them weather the storm. We’ve created insulating clothing for mountaineers so they can venture farther. One thing is at the heart of all these endeavours: an independent spirit."}],"long_name":[{"lang":"en-GB","text":"Belstaff"}],"phone_number":null,"summary":[{"lang":"en-GB","text":"Shops & Services"}],"links":[{"type":"general","url":"https://www.belstaff.com"}],"operating_hours":{"monday":[{"opening_time":"10:00","closing_time":"20:00"}],"tuesday":[{"opening_time":"10:00","closing_time":"20:00"}],"wednesday":[{"opening_time":"10:00","closing_time":"20:00"}],"thursday":[{"opening_time":"10:00","closing_time":"20:00"}],"friday":[{"opening_time":"10:00","closing_time":"20:00"}],"saturday":[{"opening_time":"10:00","closing_time":"19:00"}],"sunday":[{"opening_time":"12:00","closi
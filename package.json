    "@factoidal/core": "^0.7.1",
    "@mapbox/vector-tile": "^2.0.5",
    "@napi-rs/canvas": "^1.0.10",
    "@playwright/test": "1.56.1",
    "exceljs": "^4.4.0",
    "osm-pbf-parser": "^2.3.0",
    "pbf": "^4.0.2",
    "pdfjs-dist": "^6.4.299",
    "playwright": "1.56.1",
    "tesseract.js": "^7.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yauzl": "^2.10.0"

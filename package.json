{
  "name": "londat",
  "private": true,
  "description": "Canary Wharf / Docklands project (cwplans): the 3D page, the atlas, the knowledge graph, the data tools and the open-data extracts. Live site: https://danbri.github.io/londat/",
  "license": "SEE LICENSE IN LICENSE-DATA.md",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "check": "node cwplans/tools/check-data-register.mjs",

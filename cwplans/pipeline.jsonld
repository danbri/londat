    {
     "@id": "https://kgx.foaf.tv/id/toolbuildregistry"
    }
   ],
   "cwp:area": "registry",
   "cwp:fault": [
    "F22",
    "F25",
    "F30"
   ],
   "cwp:judgement": "Which point sets are places (joined) and which are grids or area markers (not joined) is a written list (NOT_PLACES in the tool)."

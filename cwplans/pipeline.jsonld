    },
    {
     "@id": "https://github.com/danbri/londat/blob/main/cwplans/registry/buildings.json"
    },
    {
     "@id": "https://github.com/danbri/londat/blob/main/cwplans/registry/sources/brands/branches.json"
    },
    {
     "@id": "https://github.com/danbri/londat/blob/main/cwplans/registry/sources/brands/storelocator.json"
    },

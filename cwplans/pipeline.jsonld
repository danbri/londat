    },
    {
     "@id": "https://github.com/danbri/londat/blob/main/cwplans/registry/sources/registers/charities.json"
    },
    {
     "@id": "https://github.com/danbri/londat/blob/main/cwplans/tools/jsonld-clean.mjs"
    },
    {
     "@id": "https://kgx.foaf.tv/id/srcfactoidal",
     "dcat:accessURL": "npm @factoidal/core 0.7.1 (local)",
     "dct:description": "jsonldToRdf, parse (N-Triples, N-Quads), query (SPARQL 1.1 SELECT over named graphs)"
    }
   ],
   "prov:generated": [
    {
     "@id": "https://github.com/danbri/londat/blob/main/cwplans/../third_party/cwplans-structured-data/all.nq.gz"
    },

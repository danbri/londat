   ],
   "cwp:tool": {
    "@id": "https://github.com/danbri/londat/blob/main/cwplans/tools/join-lds.mjs"
   },
   "cwp:command": "node cwplans/tools/join-lds.mjs",
   "cwp:kind": "join",
   "cwp:rule": [
    "TOID: the registry building's TOIDs (OS Open Linked Identifiers through its UPRNs); one building: high; a TOID on 2+ buildings: medium. Solar links rated from LiDAR of 2012 or earlier carry fault F30.",
    "UPRN: the OS Open UPRN point of the venue's UPRN inside the outline (smallest outline first); an amended F22 value only at high or medium confidence, with that confidence; rounded or unresolved values never.",
    "Position: the record point inside the outline (medium), a venue within 12 m (low), venue layers with the F25 offset low, brownfield site points low (a site holds several buildings). Point sets that are grids, sensors, area markers or boundaries are not joined.",
    "Area: the building centre in the LSOA 2021, MSOA 2021 and ward 2018 polygons (high). Census context: the 2021 sheets of the GLA LSOA tables (residents, change since 2011, tenure, cars, country of birth, household deprivation)."
   ],
   "cwp:network": false,
   "cwp:deterministic": true,
   "cwp:after": [

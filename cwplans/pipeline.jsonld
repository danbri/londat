     "@id": "https://kgx.foaf.tv/id/toolbuildbranches"
    },
    {
     "@id": "https://kgx.foaf.tv/id/toolbuildregistry"
    }
   ],
   "cwp:area": "crawl",
   "cwp:fault": [],
   "cwp:judgement": "The skip list (FSA pages, OSM, Wikidata, Companies House, Land Registry, Wikipedia) is a licence and source-of-truth decision written in the tool."
  },

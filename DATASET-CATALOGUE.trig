  cat:source_ign_mdt05 cat:registeredMetadata "{\"attribution\": \"MDT05 © Instituto Geográfico Nacional\", \"licence\": \"CC BY 4.0 (Orden FOM/2807/2015; IGN / CNIG licence conditions)\", \"licence_url\": \"https://creativecommons.org/licenses/by/4.0/\", \"name\": \"MDT05 and MDT25: digital terrain models of Spain, 5 m and 25 m grids (Instituto Geográfico Nacional, CNIG), read through the INSPIRE WCS 2.0 of the IDEE (coverages Elevacion4258_5 for the place, Elevacion4258_25 for its 8 km terrain ring; ETRS89 geographic, integer metres on REDNAP)\", \"note\": \"Used for the place León (region config leon, adapter es-ign): the terrain of the tiles and the ground under each building. The GeoTIFF stays in cwplans/data/raw/places/leon/ (not committed); the committed tiles hold a 33 x 33 heightfield per tile a 33 x 33 grid in features.json and a 97 x 97 grid of the 8 km ring (from MDT25), resampled from it.\", \"publisher\": \"Instituto Geográfico Nacional (IGN) / Centro Nacional de Información Geográfica (CNIG), Spain\", \"url\": \"https://servicios.idee.es/wcs-inspire/mdt\"}" .

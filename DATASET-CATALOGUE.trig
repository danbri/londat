  cat:source_es_catastro_inspire_bu schema:creditText "Dirección General del Catastro (heights computed from its data)" .
  cat:source_es_catastro_inspire_bu schema:publisher "Dirección General del Catastro (Ministerio de Hacienda), Spain" .
  cat:source_es_catastro_inspire_bu cat:registeredMetadata "{\"attribution\": \"Dirección General del Catastro (heights computed from its data)\", \"licence\": \"Catastro licence v1.0 (July 2016): reuse, also commercial, of data that the user has transformed; the original data may not be redistributed\", \"licence_url\": \"https://www.catastro.hacienda.gob.es/webinspire/documentos/Licencia.pdf\", \"name\": \"Dirección General del Catastro, INSPIRE Buildings (BU) of the municipality of León (ATOM download A.ES.SDGC.BU.24900.zip): building parts with numberOfFloorsAboveGround\", \"publisher\": \"Dirección General del Catastro (Ministerio de Hacienda), Spain\", \"review\": \"Owner, 2026-10-11: \\\"Catastro - yes\\\", for the León region only as transformed data (CLAUDE.md, data policy). Used only to compute heights: an OSM building with no height or building:levels takes the area-weighted median floors of the Catastro building parts whose centroid lies inside it, times 3 m. No Catastro geometry, id or attribute is committed or published; the zip and the parsed parts stay in cwplans/data/raw/places/leon/ (git-ignored). Re-check before the project leaves the prototyping phase.\", \"review_exit\": \"catastro-ign\", \"url\": \"https://www.catastro.hacienda.gob.es/INSPIRE/Buildings/24/24900-LEON/A.ES.SDGC.BU.24900.zip\"}" .

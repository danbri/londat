  cat:artifact_194 a schema:Dataset .
  cat:artifact_194 schema:name "docklands/data/sky/metar-history.json" .
  cat:artifact_194 schema:description "London City Airport (EGLC) METAR reports of the last year (375 days to the build day), decoded to integer columns on a 30-minute grid: wind direction (tens of degrees true, VRB), speed and gust (kt), visibility (hundreds of m), weather groups and cloud groups (indices into dictionaries, with the lowest BKN/OVC/VV base and the largest cover per cloud entry), temperature and dew point; with the source URL, the licence text, the input SHA-256, the gaps over 60 minutes and the decode faults. The Three.js port shows its wind (by vector between reports) and its cloud layers, visibility, rain and fog for clock times older than the live-cache branch keeps (24 hours)" .
  cat:artifact_194 schema:includedInDataCatalog cat:catalogue .
  cat:artifact_194 cat:path "cwplans/docklands/data/sky/metar-history.json" .
  cat:artifact_194 cat:registeredMetadata "{\"fetched\": \"one request to asos.py (data=metar) for the whole period, 2026-10-12\", \"note\": \"Public domain (IEM); attribution: METAR London City Airport (EGLC): Iowa Environmental Mesonet, Iowa State University. Reports as published, not cleaned; not for aviation.\", \"osm\": {\"use\": \"none\"}, \"path\": \"docklands/data/sky/metar-history.json\", \"produced_by\": \"tools/build-metar-history.mjs\", \"shown_on\": [\"../docklands/index.html (the Three.js port: layers/wind.js, layers/weather.js)\"], \"sources\": [\"iem-asos-metar\"], \"what\": \"London City Airport (EGLC) METAR reports of the last year (375 days to the build day), decoded to integer columns on a 30-minute grid: wind direction (tens of degrees true, VRB), speed and gust (kt), visibility (hundreds of m), weather groups and cloud groups (indices into dictionaries, with the lowest BKN/OVC/VV base and the largest cover per cloud entry), temperature and dew point; with the source URL, the licence text, the input SHA-256, the gaps over 60 minutes and the decode faults. The Three.js port shows its wind (by vector between reports) and its cloud layers, visibility, rain and fog for clock times older than the live-cache branch keeps (24 hours)\"}" .
  cat:artifact_194 cat:sourcePeriodNote "one request to asos.py (data=metar) for the whole period, 2026-10-12" .
  cat:artifact_194 cat:osmUse "none" .

  cat:artifact_539 a schema:Dataset .
  cat:artifact_539 schema:name "docklands/data/piers.json" .
  cat:artifact_539 schema:description "piers, pontoons, gangways and fixed jetties in the 3D model box (cut from OSM pier shapes), the TfL river-bus piers with their lines, tour-boat piers with the operators' published frequencies, the berth of each passenger pier, and the berthed vessels with an OSM outline (HMS Belfast with facts, light vessel, tug, steam coasters, the floating church) with their size, heading and the model buildings they replace" .
  cat:artifact_539 schema:includedInDataCatalog cat:catalogue .
  cat:artifact_539 cat:path "cwplans/docklands/data/piers.json" .
  cat:artifact_539 cat:registeredMetadata "{\"fetched\": \"2026-10-09 (OSM extract of 2026-10-09T01:42:39Z, fetched again into the raw folder on 2026-10-09; the register's osmfr-greater-london entry records the 2026-10-01 copy)\", \"note\": \"The boats alongside on the page are simulated from the TfL timetable (feeds/river/river-bus.json) and the operators' frequencies, not positions. HMS Belfast facts from Wikidata Q757178 (CC0); the paint scheme is an approximation (Admiralty Disruptive Camouflage Type 25).\", \"osm\": {\"extract\": \"osmfr-greater-london\", \"use\": \"derived\", \"what\": \"pier outlines cut into pontoons, gangways and decks; ship outlines as length, beam and heading; OSM ids, names and a few tags (operator, website, wikidata, start_date)\"}, \"path\": \"docklands/data/piers.json\", \"produced_by\": \"tools/build-piers.mjs\", \"shown_on\": [\"../docklands/index.html (the Three.js port: layers/piers.js)\"], \"sources\": [\"osm\", \"tfl-unified-api\", \"wikidata\", \"tour-operator-pages\"], \"what\": \"piers, pontoons, gangways and fixed jetties in the 3D model box (cut from OSM pier shapes), the TfL river-bus piers with their lines, tour-boat piers with the operators' published frequencies, the berth of each passenger pier, and the berthed vessels with an OSM outline (HMS Belfast with facts, light vessel, tug, steam coasters, the floating church) with their size, heading and the model buildings they replace\"}" .
  cat:artifact_539 cat:sourcePeriodNote "2026-10-09 (OSM extract of 2026-10-09T01:42:39Z, fetched again into the raw folder on 2026-10-09; the register's osmfr-greater-london entry records the 2026-10-01 copy)" .
  cat:artifact_539 cat:osmUse "derived" .
  cat:artifact_539 cat:trackedFileCount 1 .
  cat:artifact_539 cat:measuredBytes 109065 .

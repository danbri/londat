  cat:artifact_45 a schema:Dataset .
  cat:artifact_45 schema:name "registry/buildings.json" .
  cat:artifact_45 schema:description "1,129 buildings with ids, names, house names, occupants (OSM, FSA, Wikidata, chain-store branches, the Canary Wharf Group directory and the regulatory and public registers: schools, care, NHS organisations, charities, childcare, betting shops, sports sites), owners, postcodes and joins; each occupant link keeps its placement (placed, placed_by, placed_confidence, placement_fault, point_in): the mall and postcode-centre rule of tools/registry-placement.mjs (F4, F7) moved 163 links to their mall host or key building, confirmed 152 and listed 40 under their postcode (2026-10-21); the branch-key rule of tools/registry-branch-key.mjs (F46, F20) made one occupant of the records of one branch from different sources (181 merges, 184 records absorbed: 1,446 -> 1,262 occupants; every source record kept in merged_from, with branch_key, merge_rule, merge_confidence, merge_evidence) and lists 36 uncertain pairs or groups in branch_merge_review (2026-10-21)" .
  cat:artifact_45 schema:includedInDataCatalog cat:catalogue .
  cat:artifact_45 cat:path "cwplans/registry/buildings.json" .
  cat:artifact_45 cat:registeredMetadata "{\"osm\": {\"extract\": \"osmfr-greater-london\", \"use\": \"derived\", \"what\": \"building outlines (centroid, area), names, house names, levels, addresses; occupant names, brands, levels, opening hours, cuisine, wheelchair access, check and start dates, operator and business contact tags (website, phone, email, contact:* links)\"}, \"path\": \"registry/buildings.json\", \"produced_by\": \"tools/build-registry.mjs, then tools/join-web-facts.mjs; on 2026-10-21 tools/registry-placement.mjs (operation place-occupants-by-mall-and-postcode) applied the placement rule to the committed file, then tools/registry-branch-key.mjs (operation merge-occupants-by-branch-key) the branch-key rule\", \"review\": \"occupants include CWG page links, mall names and levels from cwg-directory.json; 106 occupants come from the CWG directory alone, placed by street address, mall host outline or postcode with a confidence; cwg_unplaced lists the entries with no building and why. Business phone and email from OSM are kept under the cwplans exception (owner, 2026-10-03). Register links keep the key (UPRN, register point, mall, street address, name, postcode), its precision and a confidence; registers_unplaced and registers_uprn_rejected list what was not placed and why. Charity contact addresses are placed only by UPRN or a non-residential building (owner, 2026-10-03)\", \"review_exit\": [\"cwg-crawl\", \"personal-data\"], \"shown_on\": [\"registry/index.html\"], \"sources\": [\"osm\", \"wikidata\", \"fsa\", \"onspd\", \"os-open-uprn\", \"lbsm\", \"hmlr-inspire\", \"hmlr-price-paid\", \"companies-house\", \"nsi\", \"cwg-site\", \"own\", \"dfe-gias\", \"cqc-directory\", \"nhs-ods\", \"charity-commission\", \"ofsted-childcare-mi\", \"gambling-commission-premises\", \"sport-england-active-places\"], \"what\": \"1,129 buildings with ids, names, house names, occupants (OSM, FSA, Wikidata, chain-store branches, the Canary Wharf Group directory and the regulatory and public registers: schools, care, NHS organisations, charities, childcare, betting shops, sports sites), owners, postcodes and joins; each occupant link keeps its placement (placed, placed_by, placed_confidence, placement_fault, point_in): the mall and postcode-centre rule of tools/registry-placement.mjs (F4, F7) moved 163 links to their mall host or key building, confirmed 152 and listed 40 under their postcode (2026-10-21); the branch-key rule of tools/registry-branch-key.mjs (F46, F20) made one occupant of the records of one branch from different sources (181 merges, 184 records absorbed: 1,446 -> 1,262 occupants; every source record kept in merged_from, with branch_key, merge_rule, merge_confidence, merge_evidence) and lists 36 uncertain pairs or groups in branch_merge_review (2026-10-21)\"}" .
  cat:artifact_45 cat:osmUse "derived" .
  cat:artifact_45 cat:trackedFileCount 1 .
  cat:artifact_45 cat:measuredBytes 2953155 .

  cat:source_gsi_opw_lidar_dtm cat:registeredMetadata "{\"attribution\": \"Contains Irish Public Sector Data (Geological Survey Ireland & the Office of Public Works) licensed under a Creative Commons Attribution 4.0 International (CC BY 4.0) licence.\", \"licence\": \"CC BY 4.0 (the attribution statement in the coverage layer and in Copyright_and_Licence.txt of each zip)\", \"licence_url\": \"https://creativecommons.org/licenses/by/4.0/\", \"name\": \"Geological Survey Ireland open topographic LiDAR: OPW National Flood (NASC) survey 2011, 2 m DTM tiles (2 x 2 km GeoTIFF zips, Irish Transverse Mercator EPSG:2157, heights above Malin Head)\", \"note\": \"Used for the place Dublin (region config dublin, adapter ie-gsi-lidar, DEM kind arcgis-tile-zips): the terrain of the core tiles (both banks of the Liffey) and the ground under each core building. A bare-earth model (DTM; the DSM in the same zips is not used). The 8 zips over the core stay in cwplans/data/raw/places/dublin/ (not committed); the committed tiles hold a 33 x 33 heightfield per tile and a 33 x 33 grid in features.json resampled from a 5 m lon/lat grid. Found 2026-10-22 through data.gov.ie; the hillshade image services of the same portal are pictures (U8), not heights, and are not used.\", \"publisher\": \"Geological Survey Ireland (GSI) and the Office of Public Works (OPW), Government of Ireland\", \"url\": \"https://gsi.geodata.gov.ie/server/rest/services/Lidar/IE_GSI_LiDAR_Coverage_OPW_NASC_IE26_ITM/FeatureServer/3 (data.gov.ie: open-topographic-lidar-data)\"}" .
  cat:source_gsi_opw_lidar_dtm cat:recordStatus "Referenced source; distribution/harvest extent must be established from artifact and manifest links." .

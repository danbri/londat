  cat:source_adsb_lol a schema:Dataset .
  cat:source_adsb_lol schema:identifier "adsb-lol" .
  cat:source_adsb_lol schema:name "adsb.lol aircraft: the live API (api.adsb.lol /v2/point/51.505/-0.02/25: ADS-B and MLAT positions within 25 nm, readsb fields), fetched in the browser by the Three.js port's Aircraft layer (docklands/layers/planes.js, docklands/planes-live.js) only after the visitor ticks 'Live aircraft'; and the daily history (GitHub releases of adsblol/globe_history_<year>, tag v<YYYY.MM.DD>-planes-readsb-prod-0: readsb trace_full files of every aircraft, about 4.2 GB a day), from which cwplans/tools/fetch-adsb-cache.mjs keeps a 7-day extract on the branch adsb-cache; and, every 5 minutes, one answer of /v2/point/51.505/-0.02/25 asked server-side by cwplans/tools/fetch-live-cache.mjs (workflow live-cache.yml), the last 60 minutes kept on the branch live-cache (aircraft.json)" .
  cat:source_adsb_lol schema:description "adsb.lol aircraft: the live API (api.adsb.lol /v2/point/51.505/-0.02/25: ADS-B and MLAT positions within 25 nm, readsb fields), fetched in the browser by the Three.js port's Aircraft layer (docklands/layers/planes.js, docklands/planes-live.js) only after the visitor ticks 'Live aircraft'; and the daily history (GitHub releases of adsblol/globe_history_<year>, tag v<YYYY.MM.DD>-planes-readsb-prod-0: readsb trace_full files of every aircraft, about 4.2 GB a day), from which cwplans/tools/fetch-adsb-cache.mjs keeps a 7-day extract on the branch adsb-cache; and, every 5 minutes, one answer of /v2/point/51.505/-0.02/25 asked server-side by cwplans/tools/fetch-live-cache.mjs (workflow live-cache.yml), the last 60 minutes kept on the branch live-cache (aircraft.json). Source listed by the project data register; listing alone does not prove acquisition or inclusion in all derived outputs." .
  cat:source_adsb_lol schema:includedInDataCatalog cat:catalogue .
  cat:source_adsb_lol dct:rights "ODbL 1.0 (share-alike): OpenAPI info.license 'Open Data Commons Open Database License (ODbL) v1.0'; 'The license for the API as well as all data ADSB.lol makes public is ODbL'; each history release README: 'This database is made available under the Open Database License' (feeders waive their rights under CC0). API free to use, no key yet ('In the future, you will require an API key'); rate limits 'dynamic', not published" .
  cat:source_adsb_lol schema:url <https://api.adsb.lol/docs> .
  cat:source_adsb_lol schema:creditText "Aircraft: © adsb.lol contributors, ODbL (https://adsb.lol, https://opendatacommons.org/licenses/odbl/1-0/)" .
  cat:source_adsb_lol cat:registeredMetadata "{\"attribution\": \"Aircraft: © adsb.lol contributors, ODbL (https://adsb.lol, https://opendatacommons.org/licenses/odbl/1-0/)\", \"history_url\": \"https://github.com/adsblol/globe_history_2026/releases\", \"licence\": \"ODbL 1.0 (share-alike): OpenAPI info.license 'Open Data Commons Open Database License (ODbL) v1.0'; 'The license for the API as well as all data ADSB.lol makes public is ODbL'; each history release README: 'This database is made available under the Open Database License' (feeders waive their rights under CC0). API free to use, no key yet ('In the future, you will require an API key'); rate limits 'dynamic', not published\", \"name\": \"adsb.lol aircraft: the live API (api.adsb.lol /v2/point/51.505/-0.02/25: ADS-B and MLAT positions within 25 nm, readsb fields), fetched in the browser by the Three.js port's Aircraft layer (docklands/layers/planes.js, docklands/planes-live.js) only after the visitor ticks 'Live aircraft'; and the daily history (GitHub releases of adsblol/globe_history_<year>, tag v<YYYY.MM.DD>-planes-readsb-prod-0: readsb trace_full files of every aircraft, about 4.2 GB a day), from which cwplans/tools/fetch-adsb-cache.mjs keeps a 7-day extract on the branch adsb-cache; and, every 5 minutes, one answer of /v2/point/51.505/-0.02/25 asked server-side by cwplans/tools/fetch-live-cache.mjs (workflow live-cache.yml), the last 60 minutes kept on the branch live-cache (aircraft.json)\", \"note\": \"Live API: fetched in the browser on request, nothing stored. api.adsb.lol sends no CORS header (checked 2026-10-09), so a browser on danbri.github.io cannot read it until adsb.lol adds the header or a relay is set up (?adsb=). History: the 7-day extract (25 nm round 51.505 N 0.02 W) is committed on the orphan branch adsb-cache, not on main (see 'branches'); the page reads it from raw.githubusercontent.com. Near-live: the 5-minute job's buffer of the last 60 minutes is committed on the orphan branch live-cache (aircraft.json; see 'branches'); the page shows it by default near now. Details: skill docklands-sky, 'Live aircraft in the Three.js port'\", \"review\": \"Accepted for scoping (owner decisions, 2026-10-09: \\\"Couldn't we crontab it for every 5 mins? And default to live for the rest?\\\", which approves the committed near-live snapshots of the last hour on the branch live-cache; \\\"adsb.lol (ODbL) (Recommended)\\\": \\\"Free live API, open data under ODbL, like OSM. Fetched in the browser only after a tap, shown with the ODbL credit, recorded in the data register as 'review', nothing committed. Simulated traffic stays as the fallback.\\\"; then, asked how the page should reach adsb.lol: \\\"Eventually find or build a proxy. For today build a cache of last 7 days for our areas, and show equivalent data for the matching time and day of week.\\\", which approves the committed 7-day cache). Review with the OSM (ODbL) use before anything leaves the prototyping phase, and before any commercial or production use (the API terms ask production users to contact adsb.lol)\", \"review_exit\": \"adsb-odbl\", \"url\": \"https://api.adsb.lol/docs\"}" .
  cat:source_adsb_lol cat:recordStatus "Referenced source; distribution/harvest extent must be established from artifact and manifest links." .
  cat:source_awc_metar a schema:Dataset .
  cat:source_awc_metar schema:identifier "awc-metar" .
  cat:source_awc_metar schema:name "METAR reports from the NOAA Aviation Weather Center data API (aviationweather.gov /api/data/metar), asked every 5 minutes by cwplans/tools/fetch-live-cache.mjs (workflow live-cache.yml) in two requests: London City Airport (EGLC, the model's station) for the last 24 hours (metar.json, the last 24 hours kept), and since 2026-10-22 the stations of the other places named in the region configs (services.metar and services.metarStations: Dublin EIDW, Berlin EDDB, Stuttgart EDDS, Saarbrücken EDDR, León LELN, Sarajevo LQSA, Amsterdam EHAM, 41 UK airports and RAF stations) for the last 2 hours (metar-places.json, the last 6 hours kept); both on the branch live-cache" .
  cat:source_awc_metar schema:description "METAR reports from the NOAA Aviation Weather Center data API (aviationweather.gov /api/data/metar), asked every 5 minutes by cwplans/tools/fetch-live-cache.mjs (workflow live-cache.yml) in two requests: London City Airport (EGLC, the model's station) for the last 24 hours (metar.json, the last 24 hours kept), and since 2026-10-22 the stations of the other places named in the region configs (services.metar and services.metarStations: Dublin EIDW, Berlin EDDB, Stuttgart EDDS, Saarbrücken EDDR, León LELN, Sarajevo LQSA, Amsterdam EHAM, 41 UK airports and RAF stations) for the last 2 hours (metar-places.json, the last 6 hours kept); both on the branch live-cache. Source listed by the project data register; listing alone does not prove acquisition or inclusion in all derived outputs." .
  cat:source_awc_metar schema:includedInDataCatalog cat:catalogue .
  cat:source_awc_metar dct:rights "NOAA/NWS: 'The information on National Weather Service (NWS) Web pages are in the public domain, unless specifically noted otherwise' (https://www.weather.gov/disclaimer, read 2026-10-09). The reports are made by the national weather service of each aerodrome (UK Met Office, Met Éireann, DWD, AEMET and others) and exchanged through the WMO (essential data, WMO Resolution 40). API terms (https://aviationweather.gov/data/api/): 'keep requests limited in scope and frequency', at most 100 requests a minute; two requests each 5 minutes are used (since 2026-10-22; one before)" .
  cat:source_awc_metar schema:url <https://aviationweather.gov/data/api/> .
  cat:source_awc_metar schema:creditText "METAR: NOAA Aviation Weather Center (aviationweather.gov); the station is named on the page (London City Airport EGLC in the model; the place's own or nearest station elsewhere)" .
  cat:source_awc_metar cat:registeredMetadata "{\"attribution\": \"METAR: NOAA Aviation Weather Center (aviationweather.gov); the station is named on the page (London City Airport EGLC in the model; the place's own or nearest station elsewhere)\", \"licence\": \"NOAA/NWS: 'The information on National Weather Service (NWS) Web pages are in the public domain, unless specifically noted otherwise' (https://www.weather.gov/disclaimer, read 2026-10-09). The reports are made by the national weather service of each aerodrome (UK Met Office, Met Éireann, DWD, AEMET and others) and exchanged through the WMO (essential data, WMO Resolution 40). API terms (https://aviationweather.gov/data/api/): 'keep requests limited in scope and frequency', at most 100 requests a minute; two requests each 5 minutes are used (since 2026-10-22; one before)\", \"name\": \"METAR reports from the NOAA Aviation Weather Center data API (aviationweather.gov /api/data/metar), asked every 5 minutes by cwplans/tools/fetch-live-cache.mjs (workflow live-cache.yml) in two requests: London City Airport (EGLC, the model's station) for the last 24 hours (metar.json, the last 24 hours kept), and since 2026-10-22 the stations of the other places named in the region configs (services.metar and services.metarStations: Dublin EIDW, Berlin EDDB, Stuttgart EDDS, Saarbrücken EDDR, León LELN, Sarajevo LQSA, Amsterdam EHAM, 41 UK airports and RAF stations) for the last 2 hours (metar-places.json, the last 6 hours kept); both on the branch live-cache\", \"note\": \"No CORS header on aviationweather.gov (checked 2026-10-09 with Origin https://danbri.github.io), so the browser reads the copy on the live-cache branch. The Three.js port's wind layer uses the METAR wind within 45 minutes of the page clock, before Open-Meteo; the weather layer uses its cloud layers and visibility. Since 2026-10-22 (issue https://github.com/danbri/londat/issues/12): each place shows only its own station or the nearest within 50 km (docklands/geo/services.js), never EGLC outside London. The API gives at most 400 reports an answer (49 stations x 24 hours came back cut), so the places' request asks 2 hours. Skill docklands-sky, 'METAR (London City Airport)' and 'Live data of the place in view'\", \"review\": \"Owner, 2026-10-09: \\\"Yes\\\" (use the real airport observation for the wind) and \\\"Basically we want all the data we can\\\". Public domain in the US; the origin (UK Met Office, Met Éireann, DWD, AEMET, BHANSA and the other national services that make the reports) is an open question to review before anything leaves the prototyping phase\", \"review_exit\": \"metar-origin\", \"url\": \"https://aviationweather.gov/data/api/\"}" .
  cat:source_awc_metar cat:recordStatus "Referenced source; distribution/harvest extent must be established from artifact and manifest links." .
  cat:source_iem_asos_metar a schema:Dataset .
  cat:source_iem_asos_metar schema:identifier "iem-asos-metar" .
  cat:source_iem_asos_metar schema:name "London City Airport (EGLC) METAR reports of the last year from the Iowa Environmental Mesonet ASOS/METAR archive (Iowa State University), cgi-bin/request/asos.py?station=EGLC&data=metar (routine and special reports), one request for the whole period by cwplans/tools/build-metar-history.mjs" .
  cat:source_iem_asos_metar schema:description "London City Airport (EGLC) METAR reports of the last year from the Iowa Environmental Mesonet ASOS/METAR archive (Iowa State University), cgi-bin/request/asos.py?station=EGLC&data=metar (routine and special reports), one request for the whole period by cwplans/tools/build-metar-history.mjs. Source listed by the project data register; listing alone does not prove acquisition or inclusion in all derived outputs." .
  cat:source_iem_asos_metar schema:includedInDataCatalog cat:catalogue .
  cat:source_iem_asos_metar dct:rights "public domain: IEM disclaimer (https://mesonet.agron.iastate.edu/disclaimer.php, read 2026-10-12): 'The materials found on this website are in the public domain and may be used freely by anyone for any lawful purpose. Attributing the Iowa Environmental Mesonet of Iowa State University would be appreciated.' Service terms (asos.py help, read 2026-10-12): an IP-based rate limit, a 1 second per-IP throttle, at most 1,000 station-years a request; robots.txt Crawl-delay 120 (one request is made). The reports are made by the UK Met Office for the aerodrome and exchanged through the WMO (essential data, WMO Resolution 40), as for awc-metar" .
  cat:source_iem_asos_metar schema:url <https://mesonet.agron.iastate.edu/request/download.phtml> .
  cat:source_iem_asos_metar schema:creditText "METAR London City Airport (EGLC): Iowa Environmental Mesonet, Iowa State University (ASOS/METAR archive)" .
  cat:source_iem_asos_metar cat:registeredMetadata "{\"attribution\": \"METAR London City Airport (EGLC): Iowa Environmental Mesonet, Iowa State University (ASOS/METAR archive)\", \"licence\": \"public domain: IEM disclaimer (https://mesonet.agron.iastate.edu/disclaimer.php, read 2026-10-12): 'The materials found on this website are in the public domain and may be used freely by anyone for any lawful purpose. Attributing the Iowa Environmental Mesonet of Iowa State University would be appreciated.' Service terms (asos.py help, read 2026-10-12): an IP-based rate limit, a 1 second per-IP throttle, at most 1,000 station-years a request; robots.txt Crawl-delay 120 (one request is made). The reports are made by the UK Met Office for the aerodrome and exchanged through the WMO (essential data, WMO Resolution 40), as for awc-metar\", \"name\": \"London City Airport (EGLC) METAR reports of the last year from the Iowa Environmental Mesonet ASOS/METAR archive (Iowa State University), cgi-bin/request/asos.py?station=EGLC&data=metar (routine and special reports), one request for the whole period by cwplans/tools/build-metar-history.mjs\", \"note\": \"Same reports as awc-metar (NOAA AWC keeps only recent days; IEM keeps the archive). Checked 2026-10-12: the 31 reports in both the live-cache metar.json and the file decode to the same wind, gust, visibility and temperature. Skill docklands-sky, 'METAR history'\", \"review\": \"Public domain as distributed by IEM; the Met Office origin is the same open question as for awc-metar: review before anything leaves the prototyping phase\", \"review_exit\": \"metar-origin\", \"url\": \"https://mesonet.agron.iastate.edu/request/download.phtml\"}" .
  cat:source_iem_asos_metar cat:recordStatus "Referenced source; distribution/harvest extent must be established from artifact and manifest links." .

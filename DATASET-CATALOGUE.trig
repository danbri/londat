  cat:artifact_193 cat:registeredMetadata "{\"note\": \"Values derived from OGL v3.0 readings (attribution: This uses Environment Agency flood and river level data from the real-time data API (Beta)); readings from the flood-monitoring API (about four weeks kept) and its daily archive files (one day in seven back to a year); not a published tide table and not for navigation; PLA and UKHO predictions were not used (not open).\", \"osm\": {\"use\": \"none\"}, \"path\": \"docklands/data/sky/tide-harmonics.json\", \"produced_by\": \"tools/fit-tide-harmonics.mjs\", \"shown_on\": [\"../docklands/index.html (the Three.js port: layers/tide.js)\"], \"sources\": [\"ea-flood-monitoring\"], \"what\": \"our own tide prediction: harmonic constituents (a mean z0 and 34 constituents, amplitude and phase lag) fitted per gauge at Tower Pier, Charlton and Silvertown to cleaned EA 15-minute tidal levels (m AOD), with the fit period, rms residual, high- and low-water errors, a validation on held-out days, the cleaned readings of the last 7 days and check values for the page code\"}" .

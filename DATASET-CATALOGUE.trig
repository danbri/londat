  cat:artifact_541 cat:path "cwplans/docklands/data/wildlife.json" .
  cat:artifact_541 cat:registeredMetadata "{\"fetched\": \"2026-10-09\", \"note\": \"The animals on the page are simulated: species, numbers and places are weighted by these counts and by general ecology (stated in the file and the layer); positions are not observations. Record counts measure recording effort, not abundance.\", \"osm\": {\"extract\": \"osmfr-greater-london\", \"use\": \"derived\", \"what\": \"water polygons (area.js) and green areas (trees.json) rasterised to habitat classes at 10 m; records classified by those classes (counts only)\"}, \"path\": \"docklands/data/wildlife.json\", \"produced_by\": \"tools/fetch-wildlife.mjs\", \"shown_on\": [\"../docklands/index.html (the Three.js port: layers/wildlife.js)\"], \"sources\": [\"nbn-atlas\", \"gbif\", \"osm\", \"os-open-greenspace\", \"fr-tow\"], \"what\": \"aggregates of open wildlife records in the model box for the Three.js port's wildlife layer: for 20 bird species and the red fox, the number of records, records per habitat class (records located to 100 m or better), per month, years and flock sizes, the weights per habitat blended with general ecology; and a 10 m habitat class raster (river, dock, pond, park, wood, garden; RLE). No record points.\"}" .
  cat:artifact_541 cat:sourcePeriodNote "2026-10-09" .

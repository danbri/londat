  cat:source_esa_worldcover cat:registeredMetadata "{\"attribution\": \"© ESA WorldCover project 2021 / Contains modified Copernicus Sentinel data (2021) processed by ESA WorldCover consortium\", \"licence\": \"CC BY 4.0\", \"licence_class\": \"open\", \"licence_url\": \"https://creativecommons.org/licenses/by/4.0/\", \"name\": \"ESA WorldCover 10 m 2021 v200: land cover in 11 classes from Sentinel-1 and Sentinel-2 (3 x 3 degree Cloud Optimized GeoTIFFs on the AWS Registry of Open Data, bucket esa-worldcover), read by HTTP range requests at overview 1 (about 20 m)\", \"note\": \"Used for the places on the globe (adapter docklands/geo/adapters/world-surround.js, world-worldcover): the colours of the ground textures of the surroundings tiles (trees, shrubs, grass, crops, built-up, bare, water, wetland). The window stays in cwplans/data/raw/places/<id>/landcover.bin.gz (git-ignored); only the painted JPEG textures (resampled, mixed with roads and water: a change, stated) are committed. Also used for the German places (2026-10-22: berlin, stuttgart, dagstuhl; sets in danbri/docklandia data/de/).\", \"publisher\": \"European Space Agency (ESA), WorldCover consortium\", \"url\": \"https://esa-worldcover.org/en/data-access\"}" .

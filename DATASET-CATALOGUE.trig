  cat:source_ghsl_built_h schema:name "GHS-BUILT-H R2023A: average net building height (ANBH), epoch 2018, 3 arc-second grid (EPSG:4326), 10 x 10 degree tiles (Global Human Settlement Layer)" .
  cat:source_ghsl_built_h schema:description "GHS-BUILT-H R2023A: average net building height (ANBH), epoch 2018, 3 arc-second grid (EPSG:4326), 10 x 10 degree tiles (Global Human Settlement Layer). Source listed by the project data register; listing alone does not prove acquisition or inclusion in all derived outputs." .
  cat:source_ghsl_built_h schema:includedInDataCatalog cat:catalogue .
  cat:source_ghsl_built_h dct:rights "CC BY 4.0 (Commission reuse policy, Decision 2011/833/EU; copyright.txt in the GHS_BUILT_H_GLOBE_R2023A folder: \"(c) European Union, 1995-2026\")" .

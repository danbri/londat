  cat:artifact_540 a schema:Dataset .
  cat:artifact_540 schema:name "docklands/data/moorings.json" .
  cat:artifact_540 schema:description "GENERIC boats at known moorings for the Three.js port (layer river, part Moorings and houseboats): the mooring places in the model box (OSM houseboat outlines, pontoons of moorings, mooring lines, quay edges of marinas, mooring buoys) with their class (canal, residential, tidal residential, marina, mixed, tier) and the generic boats (position, heading, length, beam, a model type) placed along them by one rule from OSM tags and geometry; the model buildings of the houseboat outlines to hide. Not real vessels: types and sizes are typical values chosen by a seeded hash." .
  cat:artifact_540 schema:includedInDataCatalog cat:catalogue .
  cat:artifact_540 cat:path "cwplans/docklands/data/moorings.json" .
  cat:artifact_540 cat:registeredMetadata "{\"fetched\": \"2026-10-11 (OSM data of 2026-10-11T18:22:45Z; pontoons from the extract of 2026-10-09T01:42:39Z)\", \"note\": \"The boats are generic (typical types, sizes and colours by the class of mooring); the tap card and describe() say so. No houseboat names, addresses, contacts or occupants are kept, though the cwplans exception would allow them.\", \"osm\": {\"extract\": \"overpass-2026-10-11-moorings\", \"use\": \"derived\", \"what\": \"OSM ids, shapes (as positions, headings and rectangles), the mooring, leisure, access, operator, seamark and capacity tags and the names of moorings and marinas (not of houseboats); and the pontoon shapes of docklands/data/piers.json (extract osmfr-greater-london)\"}, \"path\": \"docklands/data/moorings.json\", \"produced_by\": \"tools/build-moorings.mjs\", \"review\": \"OSM ODbL derived database: review with the other OSM uses before the prototyping phase ends.\", \"review_exit\": \"osm-odbl\", \"shown_on\": [\"../docklands/index.html (the Three.js port: layers/river.js, moored-boats.js)\"], \"sources\": [\"osm\"], \"what\": \"GENERIC boats at known moorings for the Three.js port (layer river, part Moorings and houseboats): the mooring places in the model box (OSM houseboat outlines, pontoons of moorings, mooring lines, quay edges of marinas, mooring buoys) with their class (canal, residential, tidal residential, marina, mixed, tier) and the generic boats (position, heading, length, beam, a model type) placed along them by one rule from OSM tags and geometry; the model buildings of the houseboat outlines to hide. Not real vessels: types and sizes are typical values chosen by a seeded hash.\"}" .
  cat:artifact_540 cat:sourcePeriodNote "2026-10-11 (OSM data of 2026-10-11T18:22:45Z; pontoons from the extract of 2026-10-09T01:42:39Z)" .
  cat:artifact_540 cat:osmUse "derived" .
  cat:artifact_540 cat:trackedFileCount 1 .
  cat:artifact_540 cat:measuredBytes 51427 .
  cat:artifact_540 schema:isBasedOn cat:source_osm .
  cat:model schema:hasPart cat:artifact_540 .
  cat:documentation schema:hasPart cat:artifact_540 .
  cat:artifact_540 prov:wasDerivedFrom <https://github.com/danbri/londat/blob/5ece04a8144e962ba40fac81e724b106161d4dcb/cwplans/data-register.json> .

  cat:source_web_structured_data cat:registeredMetadata "{\"crawl\": {\"date\": \"2026-10-03\", \"method\": \"headless Chromium (Playwright) with a desktop Chrome User-Agent plus \\\" glitchcan-cwplans/0.1 (+https://github.com/danbri/glitchcan-minigam)\\\"; robots.txt obeyed (RFC 9309) for every page navigation and redirect; at most 3 pages at once, one page at a time per host, at least 2 s between page loads on a host; images, media and fonts not loaded; load + network idle (20 s cap) + 1.5 s; cookie banners accepted only when a page showed no structured data; store finders searched once per brand and branch postcode; Internet Archive copies of canarywharf.com pages read from the local fetch-cwg.mjs cache with scripts off (no request)\", \"tool\": \"tools/render-structured-data.mjs\"}, \"licence\": \"none stated (all rights reserved by default); the site owners publish this markup for search engines\", \"name\": \"schema.org structured data (JSON-LD, microdata, RDFa) published on the web pages of the entities the registry tracks: occupant, brand, store and charity sites\", \"note\": \"Crawl for scoping, allowed by the owner (2026-10-03: \\\"Website crawls - direct and via IA or CommonCrawl etc are fair use for our scoping purposes.\\\"). Store-finder searches with UK postcodes allowed by the owner (2026-10-03: \\\"we are permitted per industry convention to submit storefinder forms with UK postcodes\\\"). Only the structured-data blocks, page title, final URL, status and a hash of the rendered HTML are kept; no full pages are committed. Re-check before anything leaves the prototyping phase.\"}" .
  cat:source_web_structured_data cat:recordStatus "Referenced source; distribution/harvest extent must be established from artifact and manifest links." .
